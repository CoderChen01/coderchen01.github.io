---
layout: post
---
<section class="scholarly-abstract" aria-labelledby="scholarly-abstract-title">
  <p class="scholarly-authors">{{ page.scholarly.authors | join: '; ' | escape }}</p>
  <p class="scholarly-kind">
    {% if page.scholarly.kind == 'technical-report' %}Technical report{% else %}Research Blog{% endif %}
    {% if page.scholarly.institution and page.scholarly.institution != '' %} · {{ page.scholarly.institution | escape }}{% endif %}
    {% if page.scholarly.report_number and page.scholarly.report_number != '' %} · {{ page.scholarly.report_number | escape }}{% endif %}
  </p>
  <h2 id="scholarly-abstract-title">Abstract</h2>
  <p>{{ page.scholarly.abstract | escape | newline_to_br }}</p>
  {% if page.scholarly.pdf and page.scholarly.pdf != '' %}
    <a href="{{ page.url | append: 'paper.pdf' | relative_url }}">Read PDF ↗</a>
  {% endif %}
</section>

{{ content }}

<section class="scholarly-citation" aria-labelledby="scholarly-citation-title">
  <h2 id="scholarly-citation-title">Cite this article</h2>
  <p class="scholarly-citation-actions">
    <button type="button" data-copy-scholarly-citation>Copy BibTeX</button>
    <a href="{{ page.url | append: 'citation.bib' | relative_url }}" download>Download .bib</a>
    {% if page.scholarly.pdf and page.scholarly.pdf != '' %}
      <a href="{{ page.url | append: 'paper.pdf' | relative_url }}">PDF ↗</a>
    {% endif %}
  </p>
  <pre><code data-scholarly-bibtex>{{ page.scholarly_bibtex | escape }}</code></pre>
</section>
{% if page.scholarly.license == 'CC-BY-NC-ND-4.0' %}
  <p class="scholarly-license"><a rel="license" href="https://creativecommons.org/licenses/by-nc-nd/4.0/">CC BY-NC-ND 4.0</a></p>
{% elsif page.scholarly.license == 'CC-BY-4.0' %}
  <p class="scholarly-license"><a rel="license" href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a></p>
{% endif %}
<script defer src="{{ '/assets/js/scholarly.js' | relative_url | bust_file_cache }}"></script>
