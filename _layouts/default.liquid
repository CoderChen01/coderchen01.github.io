<!doctype html>
{%- comment -%}
  Site override of al_folio_core's default layout. It keeps the upstream layout
  intact while setting a two-state, dark-first theme and loading site effects.
{%- endcomment -%}
{%- capture html_attributes -%}
  {%- if site.plugins contains 'al_rtl' -%}
    {%- include plugins/al_rtl_html_attrs.liquid -%}
  {%- else -%}
    lang="{{ site.lang }}"
  {%- endif -%}
{%- endcapture -%}
<html {{ html_attributes }}>
  <head>
    <script>
      (() => {
        const savedTheme = localStorage.getItem('theme');
        const theme = savedTheme === 'light' || savedTheme === 'dark' ? savedTheme : 'dark';
        localStorage.setItem('theme', theme);
        document.documentElement.setAttribute('data-theme-setting', theme);
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% include head.liquid %}
    {% include scholarly-head.liquid %}
    <link rel="alternate" type="application/atom+xml" title="{{ site.blog_name | escape }}" href="{{ '/feed.xml' | relative_url }}">
    <link
      rel="alternate"
      type="application/atom+xml"
      title="{{ site.research_feed.title | escape }}"
      href="{{ '/research-feed.xml' | relative_url }}"
    >
    {% if site.enable_darkmode %}
      <script>
        toggleThemeSetting = () => {
          const currentTheme = determineComputedTheme();
          setThemeSetting(currentTheme === 'dark' ? 'light' : 'dark');
          updateSiteThemeToggleLabel();
        };

        const updateSiteThemeToggleLabel = () => {
          const button = document.getElementById('light-toggle');
          if (!button) return;
          const targetTheme = determineComputedTheme() === 'dark' ? 'light' : 'dark';
          button.title = `Switch to ${targetTheme} theme`;
          button.setAttribute('aria-label', `Switch to ${targetTheme} theme`);
        };

        document.addEventListener('DOMContentLoaded', updateSiteThemeToggleLabel, { once: true });
      </script>
    {% endif %}
  </head>

  <body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    {% include header.liquid %}

    <div class="container mt-5" role="main">
      {% if page.toc and page.toc.sidebar %}
        {% assign toc_collapse = page.toc.collapse | default: 'expanded' %}
        {% assign toc_collapse_depth = page.toc.collapse_depth | default: '' %}
        {% if page.toc.sidebar == 'right' %}
          <div class="row">
            <div class="col-sm-9">{{ content }}</div>
            <div class="col-sm-3">
              <nav
                id="toc-sidebar"
                class="sticky-top toc toc-sidebar"
                aria-label="Table of contents"
                data-toc-collapse="{{ toc_collapse }}"
                data-toc-collapse-depth="{{ toc_collapse_depth }}"
              ></nav>
            </div>
          </div>
        {% else %}
          <div class="row">
            <div class="col-sm-3">
              <nav
                id="toc-sidebar"
                class="sticky-top toc toc-sidebar"
                aria-label="Table of contents"
                data-toc-collapse="{{ toc_collapse }}"
                data-toc-collapse-depth="{{ toc_collapse_depth }}"
              ></nav>
            </div>
            <div class="col-sm-9">{{ content }}</div>
          </div>
        {% endif %}
      {% else %}
        {{ content }}
      {% endif %}
    </div>

    {% include footer.liquid %}
    {% include scripts.liquid %}
    <script defer src="{{ '/assets/js/site-custom.js' | relative_url | bust_file_cache }}"></script>
  </body>
</html>
