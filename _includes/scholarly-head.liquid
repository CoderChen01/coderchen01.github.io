{% if page.scholarly.enabled == true %}
  <meta name="citation_title" content="{{ page.title | escape }}">
  {% for author in page.scholarly.authors %}
    <meta name="citation_author" content="{{ author | escape }}">
  {% endfor %}
  <meta name="citation_publication_date" content="{{ page.date | date: '%Y/%m/%d' }}">
  {% if page.scholarly.doi and page.scholarly.doi != '' %}
    <meta name="citation_doi" content="{{ page.scholarly.doi | escape }}">
  {% endif %}
  {% if page.scholarly.kind == 'technical-report' %}
    {% if page.scholarly.institution and page.scholarly.institution != '' %}
      <meta name="citation_technical_report_institution" content="{{ page.scholarly.institution | escape }}">
    {% endif %}
    {% if page.scholarly.report_number and page.scholarly.report_number != '' %}
      <meta name="citation_technical_report_number" content="{{ page.scholarly.report_number | escape }}">
    {% endif %}
  {% endif %}
  {% if page.scholarly.pdf and page.scholarly.pdf != '' %}
    <meta name="citation_pdf_url" content="{{ page.url | append: 'paper.pdf' | absolute_url }}">
  {% endif %}
  {% if page.scholarly.license == 'CC-BY-NC-ND-4.0' %}
    <link rel="license" href="https://creativecommons.org/licenses/by-nc-nd/4.0/">
    <meta name="DC.rights" content="https://creativecommons.org/licenses/by-nc-nd/4.0/">
  {% elsif page.scholarly.license == 'CC-BY-4.0' %}
    <link rel="license" href="https://creativecommons.org/licenses/by/4.0/">
    <meta name="DC.rights" content="https://creativecommons.org/licenses/by/4.0/">
  {% endif %}
  {% if page.scholarly_jsonld %}
    <script type="application/ld+json">
      {{ page.scholarly_jsonld }}
    </script>
  {% endif %}
  <link rel="stylesheet" href="{{ '/assets/css/scholarly.css' | relative_url | bust_file_cache }}">
{% endif %}
