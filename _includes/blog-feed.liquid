<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang | default: 'en' | xml_escape }}">
  <id>{{ page.url | absolute_url | xml_escape }}</id>
  {% if include.research_only %}
    <title type="text">{{ site.research_feed.title | xml_escape }}</title>
    <subtitle>{{ site.research_feed.description | xml_escape }}</subtitle>
  {% else %}
    <title>{{ site.blog_name | default: site.author.name | xml_escape }}</title>
    <subtitle>{{ site.blog_description | xml_escape }}</subtitle>
  {% endif %}
  <link href="{{ page.url | absolute_url | xml_escape }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/blog/' | absolute_url | xml_escape }}" rel="alternate" type="text/html" />
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author>
    <name>{{ site.author.name | xml_escape }}</name>
    <uri>{{ site.author.uri | xml_escape }}</uri>
  </author>
  {% for post in site.posts %}
    {% if post.published != false and post.date <= site.time %}
      {% unless include.research_only and post.research_feed_included != true %}
        <entry xml:lang="{{ post.syndication_language | xml_escape }}">
          <id>{{ post.url | absolute_url | xml_escape }}</id>
          <title>{{ post.title | xml_escape }}</title>
          <link href="{{ post.url | absolute_url | xml_escape }}" rel="alternate" type="text/html" />
          <published>{{ post.date | date_to_xmlschema }}</published>
          <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
          {% for author in post.syndication_authors %}
            <author>
              <name>{{ author.name | xml_escape }}</name>
              {% if author.uri -%}
                <uri>{{ author.uri | xml_escape }}</uri>
              {%- endif %}
            </author>
          {% endfor %}
          {% if post.syndication_license_name %}
            <rights>{{ post.syndication_license_name | xml_escape }}</rights>
          {% endif %}
          {% if post.syndication_license %}
            <link rel="license" href="{{ post.syndication_license }}" />
          {% endif %}
          {% assign abstract = post.scholarly.abstract | default: post.description %}
          {% if abstract %}
            <summary type="text">{{ abstract | xml_escape }}</summary>
          {% endif %}
          {% for category in post.categories -%}
            <category term="{{ category | xml_escape }}" />
          {%- endfor %}
          {% for tag in post.tags -%}
            <category term="{{ tag | xml_escape }}" />
          {%- endfor %}
          <content type="html" xml:base="{{ post.url | absolute_url | xml_escape }}">{{ post.content | xml_escape }}</content>
        </entry>
      {% endunless %}
    {% endif %}
  {% endfor %}
</feed>
